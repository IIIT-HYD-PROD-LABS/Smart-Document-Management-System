# Production environment template for TaxSync / Smart Document Management.
# Copy to `.env.prod` on the deploy host ONLY (never commit the filled file):
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#   $EDITOR .env.prod
#
# Generate secrets:
#   SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(64))"
#   FERNET_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   REDIS_PASSWORD (optional but recommended):
#                python -c "import secrets; print(secrets.token_urlsafe(24))"

# ------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------
SECRET_KEY=replace-with-token-urlsafe-64
DATABASE_URL=postgresql://taxsync_app:CHANGE_ME@10.2.8.73:5432/taxsync
POSTGRES_DB=taxsync
POSTGRES_USER=taxsync_app
POSTGRES_PASSWORD=CHANGE_ME

APP_RUNTIME_PASSWORD=CHANGE_ME
APP_MIGRATOR_PASSWORD=CHANGE_ME
DATABASE_URL_RUNTIME=postgresql://app_runtime:CHANGE_ME@10.2.8.73:5432/taxsync
DATABASE_URL_MIGRATOR=postgresql://app_migrator:CHANGE_ME@10.2.8.73:5432/taxsync
# Prefer a real CA (DB_SSL_ROOT_CERT) over no-verify when available.
DB_SSL_NO_VERIFY=true
DB_ENFORCE_RLS=false
FERNET_KEY=replace-with-fernet-key

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=TaxSync
APP_VERSION=2.0.1
DEBUG=false

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON array of browser origins allowed by CORS
ALLOWED_ORIGINS=["https://canvas.iiit.ac.in"]

# Public URLs (OAuth redirects + email links)
FRONTEND_URL=https://canvas.iiit.ac.in/taxsyncfestage
BACKEND_URL=https://canvas.iiit.ac.in/taxsyncbestage
NEXT_PUBLIC_API_URL=https://canvas.iiit.ac.in/taxsyncbestage
BACKEND_INTERNAL_URL=http://backend:8000

# ------------------------------------------------------------
# Redis / Celery
# ------------------------------------------------------------
# Leave REDIS_PASSWORD empty for passwordless in-compose Redis (loopback-bound).
# If set, also set the three URLs to include :password@redis
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# ------------------------------------------------------------
# Storage / ML / LLM
# ------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MODEL_DIR=./models
ML_CONFIDENCE_THRESHOLD=0.3
TESSERACT_CMD=

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_TIMEOUT_SECONDS=60

# ------------------------------------------------------------
# OAuth (optional)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ------------------------------------------------------------
# Email (SMTP)
# ------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=onboarding@resend.dev
SMTP_USE_TLS=true

# ------------------------------------------------------------
# Rate limits / logging
# ------------------------------------------------------------
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DEFAULT=60/minute
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true

# ------------------------------------------------------------
# Optional third-party
# ------------------------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=
