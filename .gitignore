# Environment variables (secrets) — never commit real env files
.env
.env.local
.env.production
.env.development
.env.staging
.env.*.local
.env.prod
.env*.prod
.env.bak
.env.*.bak
# Keep templates tracked
!.env.example
!.env.prod.example
!backend/.env.example

# Offline secret backups must never land in git
.secrets-backup/

# Certificates and private keys
*.key
*.pem
*.p12
*.pfx
*.crt
*.secret
*credentials*.json

# Do NOT ignore .env.example / .env.prod.example (documentation only)

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# ML Datasets (large, downloaded from Kaggle) + scraped/sample documents
backend/datasets/raw/
backend/datasets/processed/
backend/datasets/training/
backend/datasets/sample_uploads/
backend/datasets/sebi/

# ML Model artifacts (trained models are committed; only raw Kaggle data excluded above)
# Exclude large raw model downloads if any:
backend/models/raw/

# Playwright MCP logs
.playwright-mcp/

# Screenshots (test artifacts)
*.png

# OS
.DS_Store
Thumbs.db
.gstack/
.vercel

# Local-only docker compose overrides (may contain secrets — never commit)
docker-compose.override.yml
docker-compose.override.yaml

# Build artifacts (do not ignore the whole frontend tree — source is tracked)
frontend/tsconfig.tsbuildinfo
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.env
frontend/.env.local

# Status report binary artifacts (regenerated from STATUS_REPORT.md)
Smart_Document_Management_System_Status_Report*.docx

# Real-document test PDFs (PII; never commit). Tracked fixtures live under docs/exports/.
/backend/*.pdf
backend/cand1.pdf
backend/cand2.pdf
backend/test_real_notice.pdf
