// Taxsync_Backend — reference pipeline for campus autotrigger (Stage_Taxsync_BE).
// Product Labs: point the Jenkins job at this file or call ./deploy.sh after docker build.
pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'tt0docker/stage_taxsync_be'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'test -f .env && grep -q ^SECRET_KEY= .env'
            }
        }

        stage('Build image') {
            steps {
                sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest .'
            }
        }

        stage('Deploy on host') {
            steps {
                sh 'chmod +x deploy.sh scripts/run-backend-campus.sh'
                sh 'SKIP_DOCKER_BUILD=1 DOCKER_IMAGE=${DOCKER_IMAGE} BUILD_NUMBER=${BUILD_NUMBER} ./deploy.sh'
            }
        }
    }

    post {
        failure {
            echo 'Deploy failed — check docker logs smartdocs-backend and .env on workspace.'
        }
    }
}
