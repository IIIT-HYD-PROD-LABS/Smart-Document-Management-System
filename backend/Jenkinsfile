// Taxsync_Backend — Dockerfile-only deploy (Product Labs Jenkins).
pipeline {
    agent any
    environment {
        IMAGE = 'tt0docker/stage_taxsync_be'
    }
    stages {
        stage('Build') {
            steps {
                checkout scm
                sh 'docker build -t ${IMAGE}:${BUILD_NUMBER} -t ${IMAGE}:latest .'
            }
        }
        stage('Run') {
            steps {
                sh '''
                  docker rm -f smartdocs-backend 2>/dev/null || true
                  docker run -d --name smartdocs-backend --restart unless-stopped \
                    -p 8025:8000 ${IMAGE}:${BUILD_NUMBER}
                '''
            }
        }
    }
}
