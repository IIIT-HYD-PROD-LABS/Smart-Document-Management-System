# Root-level environment template (local docker-compose.yml).
# For production on campus, use `.env.prod.example` → `.env.prod` instead.
#
# Quick start:
#   cp backend/.env.example .env
#   # fill SECRET_KEY, DATABASE_URL, etc.
#   docker compose up -d --build
#
# Canonical field documentation lives in backend/.env.example
# (this file is intentionally a short pointer so we don't drift two full copies).

# --- minimal required keys for local compose ---
SECRET_KEY=change-me-use-python-secrets-token-urlsafe-64
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=smartdocs_redis_secret
REDIS_URL=redis://:smartdocs_redis_secret@redis:6379/0
CELERY_BROKER_URL=redis://:smartdocs_redis_secret@redis:6379/0
CELERY_RESULT_BACKEND=redis://:smartdocs_redis_secret@redis:6379/0
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3100","http://localhost:3000","http://localhost:8010"]
FRONTEND_URL=http://localhost:3100
BACKEND_URL=http://localhost:8010
LLM_PROVIDER=local
